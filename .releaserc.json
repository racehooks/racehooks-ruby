{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "sed -i 's/VERSION = \"[^\"]*\"/VERSION = \"${nextRelease.version}\"/' lib/racehooks/version.rb",
        "publishCmd": "gem build racehooks.gemspec && gem push racehooks-${nextRelease.version}.gem"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["lib/racehooks/version.rb"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
